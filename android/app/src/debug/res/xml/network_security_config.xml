<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only network policy.
  The production API must be HTTPS (plain HTTP outside loopback is 403
  INSECURE_TRANSPORT). This config keeps the loopback dev endpoint working
  on Android debug builds by allowing cleartext to 127.0.0.1 / localhost.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
